# .env.example
# ForgeChain — built on AsyncTaskFlow
# Copy this file to .env and fill in your actual values

# ── ForgeChain LLM Providers ─────────────────────────────────────────────── #
# Set to one of: anthropic | gemini | grok | ollama
# If unset, first provider with an API key is chosen automatically.
FORGECHAIN_LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-pro

GROK_API_KEY=xai-...
GROK_MODEL=grok-3-mini

LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=forgechain-junior      # after running infra/ollama/setup_ollama.sh
FORGECHAIN_EMBED_MODEL=nomic-embed-text # embedding model (pulled by setup_ollama.sh)
FORGECHAIN_KB_PATH=/app/knowledge_base  # ChromaDB persistence directory

# ── GitHub Integration ────────────────────────────────────────────────────── #
# Token needs: repo (read + PR create). Never grant merge/admin permissions.
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-org/your-repo

# ── Security: PII Vault encryption key ───────────────────────────────────── #
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FORGECHAIN_VAULT_KEY=

# ── Postgres (audit log + patch storage) ─────────────────────────────────── #
POSTGRES_USER=forgechain
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=forgechain
DATABASE_URL=postgresql://forgechain:change-me-in-production@postgres:5432/forgechain

# ── Per-role worker replicas ─────────────────────────────────────────────── #
FRONTEND_DEV_REPLICAS=2
BACKEND_DEV_REPLICAS=3
QA_BACKEND_REPLICAS=2
DB_ENG_REPLICAS=1
AI_ENG_REPLICAS=2
SRE_REPLICAS=1
BA_REPLICAS=1

# ── AsyncTaskFlow core (unchanged) ───────────────────────────────────────── #

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Worker scaling configuration
WORKER_REPLICAS=3
CELERY_WORKER_CONCURRENCY=2

# Worker performance tuning
WORKER_PREFETCH_MULTIPLIER=1      # Process one task at a time (good for long tasks)

# Celery Task Limits (generous for OpenRouter API calls)
CELERY_TASK_TIME_LIMIT=900        # 15 minutes hard limit (5min task + retries + delays)
CELERY_TASK_SOFT_TIME_LIMIT=600   # 10 minutes soft warning

# Enhanced monitoring and task tracking
CELERY_WORKER_SEND_TASK_EVENTS=true
CELERY_TASK_SEND_SENT_EVENT=true
CELERY_WORKER_DISABLE_RATE_LIMITS=true
CELERY_TASK_TRACK_STARTED=true

# Task Processing Configuration
DEFAULT_RETRY_RATIO=0.3
MAX_RETRIES=3
MAX_TASK_AGE=7200                 # 2 hours max age (includes queue time + retries)

# Queue Pressure Thresholds
RETRY_QUEUE_WARNING=1000
RETRY_QUEUE_CRITICAL=5000

# Circuit Breaker Configuration
CIRCUIT_FAILURE_THRESHOLD=0.5
CIRCUIT_VOLUME_THRESHOLD=10
CIRCUIT_TIMEOUT=60

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite-preview-06-17
OPENROUTER_TIMEOUT=120            # 2 minutes API timeout

# Development Configuration
DEBUG=true
LOG_LEVEL=INFO
