# .env.example
# ForgeChain — built on AsyncTaskFlow
# Copy this file to .env and fill in your actual values

# ── ForgeChain LLM Providers ─────────────────────────────────────────────── #
# Set to one of: kilo | anthropic | gemini | grok | ollama
# If unset, first provider with a key is chosen automatically (Kilo checked first).
FORGECHAIN_LLM_PROVIDER=anthropic

# ── Kilo AI — free daily model quota (recommended for junior + mid tiers) ── #
# Get API key: https://kilo.ai/profile
# List live models: GET https://api.kilo.ai/api/gateway/models
# Rate limit (free tier): 200 req/hour per IP
KILO_API_KEY=                               # leave blank to disable
KILO_MODEL=qwen/qwen3-coder                 # default free model

# Remap tiers to Kilo free models to reduce cost:
#   FORGECHAIN_JUNIOR_PROVIDER=kilo
#   FORGECHAIN_JUNIOR_MODEL=qwen/qwen3-coder
#   FORGECHAIN_MID_PROVIDER=kilo
#   FORGECHAIN_MID_MODEL=deepseek/deepseek-r1-0528
# Senior + CTO stay on Gemini/Anthropic for reliability.
# Free Kilo models: qwen/qwen3-coder | deepseek/deepseek-r1-0528 |
#   moonshotai/kimi-k2 | moonshotai/kimi-k2.5 | minimax/minimax-m2 |
#   z-ai/glm-4-7 | z-ai/glm-4-5-air | arcee-ai/trinity-large

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-1.5-pro

GROK_API_KEY=xai-...
GROK_MODEL=grok-3-mini

LOCAL_LLM_URL=http://localhost:11434/v1
LOCAL_LLM_MODEL=forgechain-junior      # after running infra/ollama/setup_ollama.sh
FORGECHAIN_EMBED_MODEL=nomic-embed-text # embedding model (pulled by setup_ollama.sh)
FORGECHAIN_KB_PATH=/app/knowledge_base      # ChromaDB persistence directory (global, no project scope)
FORGECHAIN_PROJECTS_PATH=/app/projects      # Multi-app project root (Phase 4)
FORGECHAIN_WEIGHTS_DIR=/app/weights         # DSPy BootstrapFewShot weights written by nightly trainer
                                             # Structure: {path}/{project_id}/knowledge_base/
                                             #            {path}/shared/knowledge_base/

# ── Quant Layer (Phase 3) ─────────────────────────────────────────────────── #
FORGECHAIN_USE_BANDIT=0                     # 1 = Thompson Sampling tier routing; 0 = static map
FORGECHAIN_ENTROPY_MIN_GAIN=0.15            # Drop KB chunks with < this info gain (dedup threshold)
FORGECHAIN_COVERAGE_GAP_THRESHOLD=0.25     # Flag roles with avg retrieval score below this
FORGECHAIN_EMA_ALPHA=0.1                    # EMA decay — higher = faster response to recent outcomes
FORGECHAIN_MIN_TRAIN_EXAMPLES=10            # Min approved examples before nightly BootstrapFewShot runs

# ── Multi-app Registry (Phase 4) ─────────────────────────────────────────── #
FORGECHAIN_CROSS_PROJECT_SIMILARITY=0.75   # Similarity threshold for cross-project pattern detection
FORGECHAIN_SHARED_ENTROPY_THRESHOLD=0.50   # Min info gain before promoting chunk to shared KB

# ── GitHub Integration ────────────────────────────────────────────────────── #
# These are GLOBAL FALLBACKS — each project stores its own token + repo in the
# registry so you never have to change this file when onboarding a new project.
#
# Set per-project credentials at registration time:
#   POST /forgechain/projects  { ..., "github_token": "ghp_...", "github_repo": "org/repo" }
# Or update them later without re-registering:
#   PATCH /forgechain/projects/{id}/github  { "github_token": "ghp_..." }
#
# Token scope needed: repo (read + PR create). Never grant merge/admin permissions.
# Use fine-grained PATs (repo-scoped) so each project token can only touch its own repo.
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-org/your-repo

# ── Notifications ─────────────────────────────────────────────────────────── #
# Telegram — get token from @BotFather, chat_id from @userinfobot or channel ID
# Leave blank to disable Telegram notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord — create a webhook under Server Settings → Integrations → Webhooks
# Leave blank to disable Discord notifications.
DISCORD_WEBHOOK_URL=

# Events that trigger notifications (always-on, no per-event toggles):
#   job_review    — PR ready for human review
#   job_approved  — reviewer approved a job
#   job_rejected  — reviewer rejected a job
#   prd_wave_done — a PRD execution wave completed
#   prd_done      — full PRD execution finished
#   ema_degraded  — a worker role's quality just dropped below 0.6

# ── Sandbox Validation ───────────────────────────────────────────────────── #
# Validates ForgeChain-generated patches against the TARGET project's own
# Docker environment before moving a job to human REVIEW. Always non-blocking —
# failures attach a report to the job but never prevent REVIEW transition.
#
# Requires the worker container to mount the Docker socket:
#   volumes: ["/var/run/docker.sock:/var/run/docker.sock"]  (already in docker-compose.yml)
#
# To register a project's local repo path so the sandbox can find it:
#   redis-cli hset forgechain:registry:project:<project_id> repo_path /path/to/repo
FORGECHAIN_SANDBOX_ENABLED=0              # 1 = run sandbox validation before every REVIEW
FORGECHAIN_SANDBOX_SKIP_DOCKER=0          # 1 = skip Docker A/B steps (run project tests only, faster)
FORGECHAIN_SANDBOX_SKIP_BROWSER=0         # 1 = skip Playwright frontend smoke test
FORGECHAIN_SANDBOX_SKIP_AB=0              # 1 = skip API A/B endpoint comparison
FORGECHAIN_SANDBOX_SCREENSHOTS=/app/sandbox_screenshots   # where Playwright saves screenshots

# ── Security: PII Vault encryption key ───────────────────────────────────── #
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FORGECHAIN_VAULT_KEY=

# ── Postgres (audit log + patch storage) ─────────────────────────────────── #
POSTGRES_USER=forgechain
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=forgechain
DATABASE_URL=postgresql://forgechain:change-me-in-production@postgres:5432/forgechain

# ── Per-role worker replicas ─────────────────────────────────────────────── #
# Start with 1 replica each. Each idle Celery worker uses ~80–120 MB RAM.
# Scale up specific roles only when you have sustained queue depth.
# Each ForgeChain worker is capped at 0.5 CPU / 512 MB in docker-compose.yml.
FRONTEND_DEV_REPLICAS=1
BACKEND_DEV_REPLICAS=1
QA_BACKEND_REPLICAS=1
DB_ENG_REPLICAS=1
AI_ENG_REPLICAS=1
SRE_REPLICAS=1
BA_REPLICAS=1
FC_WORKER_CONCURRENCY=1        # Celery concurrency per worker (LLM calls are I/O-bound; keep at 1)
FC_MAX_TASKS_PER_CHILD=50      # Restart worker process after N tasks (prevents memory leaks)

# ── Ollama (local LLM) ────────────────────────────────────────────────────── #
# Ollama is OFF by default — start it only when you need local model inference:
#   docker compose --profile ollama up -d
# With Kilo / Anthropic / Gemini / Grok configured you don't need Ollama.

# ── AsyncTaskFlow core (unchanged) ───────────────────────────────────────── #

# Redis Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Worker scaling configuration
WORKER_REPLICAS=3
CELERY_WORKER_CONCURRENCY=2

# Worker performance tuning
WORKER_PREFETCH_MULTIPLIER=1      # Process one task at a time (good for long tasks)

# Celery Task Limits (generous for OpenRouter API calls)
CELERY_TASK_TIME_LIMIT=900        # 15 minutes hard limit (5min task + retries + delays)
CELERY_TASK_SOFT_TIME_LIMIT=600   # 10 minutes soft warning

# Enhanced monitoring and task tracking
CELERY_WORKER_SEND_TASK_EVENTS=true
CELERY_TASK_SEND_SENT_EVENT=true
CELERY_WORKER_DISABLE_RATE_LIMITS=true
CELERY_TASK_TRACK_STARTED=true

# Task Processing Configuration
DEFAULT_RETRY_RATIO=0.3
MAX_RETRIES=3
MAX_TASK_AGE=7200                 # 2 hours max age (includes queue time + retries)

# Queue Pressure Thresholds
RETRY_QUEUE_WARNING=1000
RETRY_QUEUE_CRITICAL=5000

# Circuit Breaker Configuration
CIRCUIT_FAILURE_THRESHOLD=0.5
CIRCUIT_VOLUME_THRESHOLD=10
CIRCUIT_TIMEOUT=60

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash-lite-preview-06-17
OPENROUTER_TIMEOUT=120            # 2 minutes API timeout

# Development Configuration
DEBUG=true
LOG_LEVEL=INFO
